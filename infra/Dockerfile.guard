FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/constraints-core.txt /tmp/constraints-core.txt
RUN python -m pip install --no-cache-dir -c /tmp/constraints-core.txt \
    "presidio-analyzer>=2.2,<3" "presidio-anonymizer>=2.2,<3" \
    "spacy>=3.7,<3.9" "nemoguardrails[openai]==0.10.0" \
    "jsonschema>=4.25,<5" "pytest>=8,<10" \
    && python -m spacy download en_core_web_lg

RUN python -m pip install --no-cache-dir "python-dotenv>=1,<2"

ENV PYTHONUNBUFFERED=1
